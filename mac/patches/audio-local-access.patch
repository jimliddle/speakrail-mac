diff --git a/app/server/local_access.h b/app/server/local_access.h
new file mode 100644
--- /dev/null
+++ b/app/server/local_access.h
@@ -0,0 +1,22 @@
+#pragma once
+#include <unordered_map>
+#include <string>
+#include <string_view>
+
+namespace minitts::server {
+// Local controller protocol, not a credential. Browser requests cannot supply
+// this non-simple header without a preflight, which this policy also rejects.
+inline bool local_controller_request(const std::unordered_map<std::string, std::string> & headers,
+                                     unsigned port, std::string_view method, std::string_view path) {
+    const auto host = headers.find("host");
+    const auto suffix = ":" + std::to_string(port);
+    if (host == headers.end() || (host->second != "127.0.0.1" + suffix &&
+        host->second != "localhost" + suffix && host->second != "[::1]" + suffix)) return false;
+    for (const auto & [name, value] : headers) {
+        if (name == "origin" || name.rfind("sec-fetch-", 0) == 0) return false;
+    }
+    if ((method == "GET" || method == "HEAD") && path == "/health") return true;
+    const auto marker = headers.find("x-speakrail-client");
+    return method != "OPTIONS" && marker != headers.end() && marker->second == "local-controller";
+}
+}
